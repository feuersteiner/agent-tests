{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"paths": {
			"agent-tests": ["./src/index.ts"]
		}
	},
	"include": ["src/**/*.ts", "cli/**/*.ts", "tests/**/*.ts"]
}
