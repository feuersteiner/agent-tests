{
	"name": "agent-tests",
	"version": "0.8.0",
	"description": "Reusable repository checks for lessons learned during agent sessions.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feuersteiner/agent-tests.git",
		"directory": "core"
	},
	"bin": {
		"agent-tests": "./cli/index.js"
	},
	"exports": {
		".": "./index.ts",
		"./types": "./src/types.ts"
	},
	"files": [
		"index.ts",
		"src",
		"cli",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts"
	],
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"ai": "7.0.162",
		"minimatch": "11.0.4",
		"yaml": "2.9.1",
		"@ai-sdk/openai": "4.0.108",
		"@ai-sdk/typesafe-ai": "3.0.33",
		"@ai-sdk/anthropic": "4.0.96",
		"zod": "^4.6.7"
	},
	"module": "./index.ts"
}
