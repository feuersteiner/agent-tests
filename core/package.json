{
	"name": "agent-tests",
	"version": "0.8.0",
	"description": "Reusable repository checks for lessons learned during agent sessions.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feuersteiner/agent-tests.git",
		"directory": "core"
	},
	"bin": {
		"agent-tests": "./dist/cli/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/src/types.d.ts",
			"import": "./dist/types.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"test": "bun run build && vitest run",
		"build": "bun run build.ts",
		"prepack": "bun run build"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"vitest": "^5.1.0",
		"ai": "7.0.162",
		"minimatch": "11.0.4",
		"yaml": "2.9.1",
		"@ai-sdk/openai": "4.0.108",
		"@ai-sdk/typesafe-ai": "3.0.33",
		"@ai-sdk/anthropic": "4.0.96"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=22"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
