{
	"name": "agentests",
	"version": "0.8.0",
	"description": "Reusable repository checks for lessons learned during agent sessions.",
	"keywords": [
		"ai-native",
		"ai-native-business",
		"ai-agents",
		"coding-agents",
		"agentic-coding",
		"agentic-workflows",
		"business-rules",
		"rules-as-code",
		"natural-language",
		"testing",
		"automated-testing",
		"regression-testing",
		"code-quality",
		"linting",
		"continuous-integration",
		"ci-cd",
		"developer-tools",
		"typescript"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feuersteiner/agent-tests.git",
		"directory": "core"
	},
	"bin": {
		"agentests": "./dist/cli/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "bun run build && bun test ./tests"
	},
	"devDependencies": {
		"@types/bun": "latest"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.96",
		"@ai-sdk/openai": "4.0.108",
		"@ai-sdk/typesafe-ai": "3.0.33",
		"ai": "7.0.162",
		"clinguini": "^1.0.1",
		"minimatch": "11.0.4",
		"yaml": "2.9.1",
		"zod": "^4.6.7"
	}
}
