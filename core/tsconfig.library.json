{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	},
	"include": ["src/index.ts", "src/vitest/index.ts", "src/vitest/runner.ts"],
	"exclude": [
		"src/**/*.test.ts",
		"src/**/__tests__/**",
		"src/**/tests/**",
		"src/**/test-support/**"
	]
}
