{
	"name": "agent-tests-workspace",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.3.4",
	"workspaces": [
		"core"
	],
	"scripts": {
		"prepare": "lefthook install",
		"build": "cp README.md LICENSE core/",
		"check": "bun run --workspaces check",
		"lint": "bun run format:check && eslint .",
		"pack": "bun run build && cd core && npm pack",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-check-file": "^3.3.2",
		"globals": "^17.6.0",
		"lefthook": "2.2.2",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	}
}
