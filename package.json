{
  "name": "agent-tests-workspace",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "core",
    "docs"
  ],
  "scripts": {
    "dev": "bun run --cwd docs dev",
    "build": "cp README.md LICENSE core/ && bun run --cwd docs build",
    "preview": "bun run --cwd docs preview",
    "check": "bun run --workspaces check",
    "pack": "bun run build && cd core && npm pack"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^6.0.3",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "5.0.5"
  },
  "type": "module"
}
